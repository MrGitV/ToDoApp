@model ToDoApp.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold">Welcome, Admin!</h1>
    <p class="lead text-muted">System-wide statistics and management overview.</p>
</div>

<div class="row text-center mb-5">
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card text-white bg-primary h-100 shadow">
            <div class="card-header border-0 pb-0"><h5 class="card-title"><i class="bi bi-people-fill"></i> Total Employees</h5></div>
            <div class="card-body d-flex flex-column justify-content-center">
                <h2 class="display-3 fw-bold">@Model.TotalEmployees</h2>
                <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-light mt-3">Manage Employees</a>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card text-white bg-success h-100 shadow">
            <div class="card-header border-0 pb-0"><h5 class="card-title"><i class="bi bi-card-checklist"></i> Total Tasks</h5></div>
            <div class="card-body d-flex flex-column justify-content-center">
                <h2 class="display-3 fw-bold">@Model.TotalTasks</h2>
                <a asp-controller="Tasks" asp-action="Index" class="btn btn-outline-light mt-3">View All Tasks</a>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card text-dark bg-warning h-100 shadow">
            <div class="card-header border-0 pb-0"><h5 class="card-title"><i class="bi bi-exclamation-triangle-fill"></i> Pending Tasks</h5></div>
            <div class="card-body d-flex flex-column justify-content-center">
                <h2 class="display-3 fw-bold">@Model.PendingTasks</h2>
                <a asp-controller="Tasks" asp-action="Index" asp-route-isCompleted="false" class="btn btn-outline-dark mt-3">View Pending</a>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card text-white bg-danger h-100 shadow">
            <div class="card-header border-0 pb-0"><h5 class="card-title"><i class="bi bi-x-octagon-fill"></i> Overdue Tasks</h5></div>
            <div class="card-body d-flex flex-column justify-content-center">
                <h2 class="display-3 fw-bold">@Model.FailedTasks</h2>
                <a asp-controller="Tasks" asp-action="Index" class="btn btn-outline-light mt-3">View Overdue</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0 text-primary"><i class="bi bi-pie-chart-fill"></i> Overall Status</h5>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <div style="width: 100%; height: 300px;">
                    <canvas id="tasksChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between">
                <h5 class="mb-0 text-success"><i class="bi bi-bar-chart-steps"></i> Employee Workload Detail</h5>
                <small class="text-muted">Scroll down if many employees</small>
            </div>
            <div class="card-body">
                <div class="chart-scroll-container">
                    <div id="chart-area" style="width: 100%;">
                        <canvas id="workloadChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
        var ctx = document.getElementById('tasksChart').getContext('2d');
        var totalTasks = parseInt('@Model.TotalTasks', 10) || 0;
        var pendingTasks = parseInt('@Model.PendingTasks', 10) || 0;
        var failedTasks = parseInt('@Model.FailedTasks', 10) || 0;
        var completedTasks = totalTasks - pendingTasks - failedTasks;

        if(totalTasks > 0) {
        new Chart(ctx, {
        type: 'doughnut',
        data: {
        labels: ['Completed', 'Pending', 'Overdue'],
        datasets: [{
        data: [completedTasks, pendingTasks, failedTasks],
        backgroundColor: ['#198754', '#ffc107', '#dc3545'],
        borderWidth: 2
        }]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });
        }

        var workloadCtx = document.getElementById('workloadChart').getContext('2d');
        var empNames = @Html.Raw(Json.Serialize(Model.EmployeeNames));
        var empCompleted = @Html.Raw(Json.Serialize(Model.CompletedTasksPerEmployee));
        var empPending = @Html.Raw(Json.Serialize(Model.PendingTasksPerEmployee));
        var empOverdue = @Html.Raw(Json.Serialize(Model.OverdueTasksPerEmployee));

        if(empNames && empNames.length > 0) {
        var dynamicHeight = Math.max(300, empNames.length * 50);
        document.getElementById('workloadChart').style.height = dynamicHeight + 'px';

        new Chart(workloadCtx, {
        type: 'bar',
        data: {
        labels: empNames,
        datasets: [
        { label: 'Completed', data: empCompleted, backgroundColor: '#198754' },
        { label: 'Pending', data: empPending, backgroundColor: '#ffc107' },
        { label: 'Overdue', data: empOverdue, backgroundColor: '#dc3545' }
        ]
        },
        options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        scales: {
        x: { stacked: true, beginAtZero: true, ticks: { stepSize: 1 } },
        y: { stacked: true }
        },
        plugins: {
        legend: { position: 'bottom' }
        }
        }
        });
        } else {
        document.getElementById('chart-area').innerHTML = '<p class="text-muted text-center mt-5">No employee data available.</p>';
        }
        });
    </script>
}